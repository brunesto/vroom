{
    "version": "0.2.0",

    "configurations": [

        {
            "name": "Debug vroom-in.json",
            "type": "cppdbg",
            "request": "launch",
            // TODO: Update this path to point to the binary created by 'make'
            "program": "${workspaceFolder}/bin/vroom",
            "args": ["-i","${workspaceFolder}/vroom-in.json","-t","1","-x","3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Allow loading GDB plugins from any path",
                    "text": "set auto-load safe-path /",
                    "ignoreFailures": true
                },
                // there does not seem to be a way to skip the whole tree
                {
                "description": "Skip stepping into STL headers",
                "text": "skip -gfi /usr/local/include/c++/13.4.0/bits/*",
                "ignoreFailures": false
                }
            ],
            "preLaunchTask": "build" // This must match the label in tasks.json,
           
        },
         {
            "name": "Run vroom-in.json",
            "type": "cppdbg",
            "noDebug": true,
            "request": "launch",
            // TODO: Update this path to point to the binary created by 'make'
            "program": "${workspaceFolder}/bin/vroom",
            "args": ["-i","${workspaceFolder}/vroom-in.json","-t","1","-x","1"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build" // This must match the label in tasks.json
        },
         {
            "name": "Tests",
            "type": "cppdbg",
            
            "request": "launch",
            // TODO: Update this path to point to the binary created by 'make'
            "program": "${workspaceFolder}/bin/run_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Allow loading GDB plugins from any path",
                    "text": "set auto-load safe-path /",
                    "ignoreFailures": true
                },
                // there does not seem to be a way to skip the whole tree
                {
                "description": "Skip stepping into STL headers",
                "text": "skip -gfi /usr/local/include/c++/13.4.0/bits/*",
                "ignoreFailures": false
                }
            ],
            "preLaunchTask": "build-test" // This must match the label in tasks.json
        }

    ]
}